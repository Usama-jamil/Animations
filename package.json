{
  "name": "Animations",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "simulator": "npm run ios -- --simulator='iPhone SE (3rd generation)'",
    "apk": "cd android && ./gradlew assembleRelease && cd ..",
    "abb": "cd android && ./gradlew bundleRelease && cd ..",
    "clean": "cd android && ./gradlew clean && cd ..",
    "info": "cd android && ./gradlew signingReport && cd ..",
    "podinstall": "cd ios && pod install && cd ..",
    "repoupdate": "cd ios && pod deintegrate && pod install --repo-update && cd .."
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-navigation/native": "^7.1.10",
    "@reduxjs/toolkit": "^1.9.7",
    "axios": "^1.9.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "moment": "^2.30.1",
    "react": "19.0.0",
    "react-i18next": "^15.5.3",
    "react-native": "0.79.3",
    "react-native-gesture-handler": "^2.25.0",
    "react-native-reanimated": "^4.0.0-beta.5",
    "react-native-worklets": "^0.3.0",
    "react-redux": "^8.1.3",
    "redux-persist": "^6.0.0",
    "redux-thunk": "^2.4.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "18.0.0",
    "@react-native-community/cli-platform-android": "18.0.0",
    "@react-native-community/cli-platform-ios": "18.0.0",
    "@react-native/babel-preset": "0.79.3",
    "@react-native/eslint-config": "0.79.3",
    "@react-native/metro-config": "0.79.3",
    "@react-native/typescript-config": "0.79.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.0.0",
    "@types/react-test-renderer": "^19.0.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.0.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
